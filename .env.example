# ------------------------------------------------------------------------------
# BOT DE CONTROL DE GASTOS POR WHATSAPP - CONFIGURACIÓN DE ENTORNO
# ------------------------------------------------------------------------------

# Configuración del Servidor FastAPI
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Credenciales de Meta Cloud API (WhatsApp)
WHATSAPP_TOKEN=tu_token_de_acceso_permanente_aqui
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui
WHATSAPP_VERIFY_TOKEN=tu_verify_token_personalizado_aqui
BOT_PHONE_NUMBER=tu_numero_de_whatsapp_en_formato_internacional  # Ej: +573001234567

# Google AI Studio (Gemini)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Credenciales de Google Cloud (Service Account)
# El valor de GOOGLE_SERVICE_ACCOUNT_JSON debe ser el contenido completo del JSON en una sola línea
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "..."}
